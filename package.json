{
  "name": "nisha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @nisha/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "~6.0.3"
  }
}
