{
  "name": "@nisha/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/database/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@nisha/contracts": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
