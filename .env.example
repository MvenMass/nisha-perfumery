# Скопируйте в .env и при необходимости поменяйте значения. .env в репозиторий не попадает.

# --- api ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Единственный origin, которому api разрешает запросы с cookie (CORS).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- docker-compose: локальная PostgreSQL ---
POSTGRES_USER=nisha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nisha
POSTGRES_PORT=5432
