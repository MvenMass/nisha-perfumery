# Скопируйте в .env и при необходимости поменяйте значения. .env в репозиторий не попадает.

# --- api ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Единственный origin, которому api разрешает запросы с cookie (CORS).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Secure-cookie: по умолчанию true в production и false в разработке (Safari не принимает их на http://localhost).
# COOKIE_SECURE=true
# Платёжный провайдер. Пока есть только mock: страница оплаты с кнопками «Оплатить» и «Отказ банка».
PAYMENT_PROVIDER=mock
# Совпадает с POSTGRES_* ниже, если БД запущена через docker compose.
DATABASE_URL=postgres://nisha:change-me@localhost:5432/nisha

# --- docker-compose: локальная PostgreSQL ---
POSTGRES_USER=nisha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nisha
POSTGRES_PORT=5432

# --- сид: администратор (pnpm db:seed) ---
ADMIN_EMAIL=admin@nisha.local
# Не короче 8 символов. Задайте свой пароль.
ADMIN_PASSWORD=change-me-please
